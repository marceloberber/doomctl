# ---------------------------------------------------------------
# doomctl — variáveis de ambiente (copie para .env)
# O ./install.sh gera este arquivo com segredos aleatórios.
# ---------------------------------------------------------------

# Versão/tag da imagem construída
DOOMCTL_VERSION=0.1.0

# Banco (PostgreSQL 18)
POSTGRES_PASSWORD=troque-esta-senha

# Chave mestra (AES-256-GCM) que criptografa segredos no banco:
# TOTP, senhas de registry, credenciais OpenTofu, kubeconfigs.
# Gere com: openssl rand -base64 32   — FAÇA BACKUP. Sem ela os segredos não podem ser lidos.
DOOMCTL_SECRET_KEY=

# Administrador inicial (criado só quando o banco está vazio).
# Sem senha, uma senha temporária é gerada e exibida em: docker compose logs doomctl
DOOMCTL_ADMIN_USER=admin
DOOMCTL_ADMIN_PASSWORD=

# Rede / TLS
DOOMCTL_BIND=0.0.0.0
DOOMCTL_PORT=8443
# self-signed (padrão) | files (use DOOMCTL_TLS_CERT/KEY montados em /certs) | off (atrás de proxy reverso com TLS)
DOOMCTL_TLS_MODE=self-signed
DOOMCTL_TLS_CERT=
DOOMCTL_TLS_KEY=

# Sessões e execução
DOOMCTL_SESSION_TTL=12h
DOOMCTL_MAX_JOBS=4

# GID do grupo docker no host (para o socket): stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Plug-in Portainer CE
DOOMCTL_PORTAINER_IMAGE=portainer/portainer-ce:lts
DOOMCTL_PORTAINER_PORT=9443

# Assistente de IA (Ollama)
#  - container do compose (perfil ai): http://ollama:11434
#  - Ollama no próprio host:           http://host.docker.internal:11434
#  - outro servidor (GPU):             http://10.0.0.50:11434
OLLAMA_HOST=http://ollama:11434
# Confirme a tag com: ollama list  (ex.: qwen3.8:27b)
OLLAMA_MODEL=qwen3.8
OLLAMA_IMAGE_TAG=latest
# Somente 0.2–0.3 (AGENTS.md). Personas, temperatura, conexões (API/MCP) e GPU
# também são configuráveis pelo navegador: Configurações → Agentes de IA.
ROUTER_TEMPERATURE=0.25

# Aceleração por GPU do Ollama em container — use ./install.sh --with-ai --gpu=1 (ou --gpu=0).
# off | nvidia | amd (vazio = não informado). O install.sh também ajusta o COMPOSE_FILE:
#   NVIDIA: COMPOSE_FILE=docker-compose.yml:docker-compose.gpu-nvidia.yml
#   AMD:    COMPOSE_FILE=docker-compose.yml:docker-compose.gpu-amd.yml
DOOMCTL_AI_GPU=

TZ=America/Sao_Paulo
